# Traffic Analyzer Web v1.52.0
MAP_BIND=0.0.0.0
MAP_PORT=8788
MAP_TITLE=Traffic Analyzer - MeshMonitor - por Alex, PT2VHF
TOPOLOGY_FILE=/var/lib/traffic-analyzer/topology.json
UI_DEFAULTS_FILE=/var/lib/traffic-analyzer/ui-defaults.json

# Log e análise de acessos web. O access.log fica, por padrão, ao lado do traffic.db.
TA_ACCESS_LOG_FILE=/var/lib/traffic-analyzer/access.log
TA_ACCESS_LOG_MAX_BYTES=20971520
TA_ACCESS_RETENTION_DAYS=365
# Opcional. Deixe vazio para não enviar IPs a serviço externo.
# Quando configurado, use {ip} no endereço e um endpoint JSON que retorne country/city.
TA_ACCESS_GEOIP_URL=

# Segurança: habilitado por padrão. Configure a senha com:
#   sudo traffic-analyzer-set-password
TA_AUTH_ENABLED=true
TA_AUTH_USER=admin
TA_AUTH_PASSWORD_HASH=
TA_AUTH_SESSION_HOURS=12
# auto adiciona Secure quando X-Forwarded-Proto=https
TA_AUTH_SECURE_COOKIE=auto

# Consultas ativas aos nós.
# auto = prefere Virtual Node e usa fallback explícito para a API do MeshMonitor.
# virtual = exige Virtual Node.
# meshmonitor = usa apenas a API de requests do MeshMonitor.
TA_NODE_QUERY_BACKEND=auto
TA_VIRTUAL_NODE_HOST=127.0.0.1
TA_VIRTUAL_NODE_PORT=4404
TA_VIRTUAL_NODE_PYTHON=/opt/traffic-analyzer/.venv/bin/python
TA_VIRTUAL_NODE_HELPER=/opt/traffic-analyzer/meshtastic_query.py
TA_VIRTUAL_NODE_CONNECT_TIMEOUT=10
TA_VIRTUAL_NODE_QUERY_TIMEOUT=30
TA_VIRTUAL_QUERY_STATE_DIR=/var/lib/traffic-analyzer/query-jobs

# Camada de elevação (DEM global Terrarium / AWS Open Data).
# Pode ser trocada por um espelho compatível sem alterar a interface.
TA_ELEVATION_TILE_BASE_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium

# Camadas meteorológicas opcionais.
# Nuvens: token do Rainbow Weather API. A chave fica apenas no backend.
TA_RAINBOW_API_TOKEN=
# Raios: chave do Lightning API. A chave fica apenas no backend.
TA_LIGHTNING_API_KEY=
# Alertas oficiais do INMET (CAP/RSS/JSON público).
TA_INMET_ALERTS_URL=https://apiprevmet3.inmet.gov.br/avisos/ativos

# Avisos automáticos no canal primário.
# Intervalo mínimo de consulta: 300 s. Padrão: 600 s.
TA_NOTICE_POLL_SECONDS=600
# Releases oficiais do firmware Meshtastic.
TA_MESHTASTIC_RELEASES_URL=https://api.github.com/repos/meshtastic/firmware/releases?per_page=20
