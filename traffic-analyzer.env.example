# Traffic Analyzer v1.27.0
MM_BASE_URL=http://127.0.0.1:3001
MM_API_TOKEN=COLE_AQUI_SEU_TOKEN_MM_V1
MM_SOURCE=default

# Descoberta/enriquecimento via traceroute
DRY_RUN=true
LOOKBACK_HOURS=24
TRACEROUTE_LIMIT=5000
NODE_COOLDOWN_HOURS=24
MAX_REQUESTS_PER_RUN=1
MAX_ATTEMPTS=3
ATTEMPT_RESET_HOURS=168
STATE_RETENTION_DAYS=30

# Topologia observada
# 0 = todo o histórico carregado pela API, limitado por TRACEROUTE_LIMIT
TOPOLOGY_LOOKBACK_HOURS=0
STATE_FILE=/var/lib/traffic-analyzer/state.json
TOPOLOGY_FILE=/var/lib/traffic-analyzer/topology.json

# Arquivo historico persistente de trafego
TRAFFIC_ARCHIVE_DB=/var/lib/traffic-analyzer/traffic.db
ARCHIVE_POLL_SECONDS=2
ARCHIVE_PAGE_SIZE=500
ARCHIVE_OVERLAP_MS=10000
# 0 = sem expiracao automatica
ARCHIVE_RETENTION_DAYS=0

# Atualização automática (arquivos de estado; normalmente não precisam ser alterados)
UPDATE_SETTINGS_FILE=/var/lib/traffic-analyzer/update-settings.json
UPDATE_REQUEST_FILE=/var/lib/traffic-analyzer/update-request.json
UPDATE_STATUS_FILE=/var/lib/traffic-analyzer/update-status.json
LAST_INSTALL_FILE=/var/lib/traffic-analyzer/last-install.json
