[Unit]
Description=Traffic Analyzer - descoberta de nós e topologia por traceroute
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/traffic-analyzer.env
ExecStart=/usr/bin/python3 /opt/traffic-analyzer/traffic_analyzer.py
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/traffic-analyzer

[Install]
WantedBy=multi-user.target
